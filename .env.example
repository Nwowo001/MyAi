# ══════════════════════════════════════════════════════════════════════════════
# AutoAgent — Environment Variables Contract
#
# Copy this file to .env (at root) and fill in real values.
# Each app also has its own .env.example with only the variables it needs.
#
# SECURITY RULES:
#   - Variables prefixed NEXT_PUBLIC_* are exposed to the browser. NEVER put
#     secrets in NEXT_PUBLIC_* variables.
#   - All secret keys belong in the backend (apps/api) only.
#   - Never commit .env files. Only commit .env.example files.
# ══════════════════════════════════════════════════════════════════════════════

# ── Node Environment ──────────────────────────────────────────────────────────
NODE_ENV=development
# Options: development | test | production


# ── Database (Supabase PostgreSQL + Prisma) ───────────────────────────────────
# Pooled connection string — used by Prisma at runtime (via PgBouncer).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1

# Direct (non-pooled) connection — used for Prisma migrations only.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres


# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase dashboard → Project Settings → API

# SAFE to expose to the browser (anon key, public URL).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# SECRET — backend only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Used by the API server to verify Supabase JWTs.
# Found in: Supabase dashboard → Project Settings → API → JWT Settings
SUPABASE_JWT_SECRET=your-supabase-jwt-secret


# ── API Server ────────────────────────────────────────────────────────────────
API_PORT=4000

# Internal API URL — used by Next.js server-side code to call the Express API.
API_URL=http://localhost:4000

# Public-facing API URL — if frontend makes client-side calls to the API.
# SAFE to expose (it's just a URL, no secret).
NEXT_PUBLIC_API_URL=http://localhost:4000


# ── Frontend ──────────────────────────────────────────────────────────────────
# Public-facing app URL — used for redirects, email links, etc.
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ── AI Provider ───────────────────────────────────────────────────────────────
# Provider identifier. Supported values: openai | anthropic | google
# Adding a new provider: implement AIProvider interface in apps/api/src/ai/provider/
AI_PROVIDER=openai

# The model to use. Configurable so you can upgrade without code changes.
# OpenAI examples:   gpt-4o | gpt-4o-mini | gpt-4-turbo
# Anthropic examples: claude-3-5-sonnet-20241022 | claude-3-opus-20240229
# Google examples:    gemini-1.5-pro | gemini-1.5-flash
AI_MODEL=gpt-4o

# SECRET — backend only.
AI_API_KEY=your-ai-api-key

# Optional: Maximum tokens per AI response (defaults set in code)
AI_MAX_TOKENS=1024

# Optional: Sampling temperature 0.0–2.0 (defaults set in code)
AI_TEMPERATURE=0.7


# ── WhatsApp (Meta Business Platform) ────────────────────────────────────────
# Found in: Meta for Developers → Your App → WhatsApp → Configuration

# SECRET — backend only. The long-lived system user access token.
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token

# The token you choose when setting up the webhook in Meta's dashboard.
WHATSAPP_VERIFY_TOKEN=your-whatsapp-verify-token

# The WhatsApp Business phone number ID (not the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# SECRET — used to verify webhook payloads are genuinely from Meta.
WHATSAPP_APP_SECRET=your-meta-app-secret

# Optional: WhatsApp API version (default in code if not set)
WHATSAPP_API_VERSION=v20.0


# ── Paystack ──────────────────────────────────────────────────────────────────
# Found in: Paystack dashboard → Settings → API Keys & Webhooks

# SECRET — backend only.
PAYSTACK_SECRET_KEY=sk_live_your-paystack-secret-key

# SAFE for frontend reference (e.g. initializing Paystack inline JS).
# Note: AutoAgent's payment flow is server-initiated, so this is rarely needed.
PAYSTACK_PUBLIC_KEY=pk_live_your-paystack-public-key

# SECRET — used to verify Paystack webhook payloads.
PAYSTACK_WEBHOOK_SECRET=your-paystack-webhook-secret


# ── Encryption ────────────────────────────────────────────────────────────────
# 32-byte (64 hex chars) random key used to encrypt stored integration tokens
# (WhatsApp access tokens, etc.) in the database.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-character-hex-encryption-key


# ── Email (optional — for custom transactional email) ─────────────────────────
# If left empty, Supabase's built-in email service is used for auth emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com
