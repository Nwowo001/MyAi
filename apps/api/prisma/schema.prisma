// AutoAgent — Unified Database Schema (Prisma ORM)
//
// Datasource configuration:
// - url: Pooled connection string (PgBouncer, port 6543) used at runtime
// - directUrl: Direct connection string (port 5432) used for migrations

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── 1. User & Business Core ───────────────────────────────────────────────────

model User {
  id            String           @id @default(uuid())
  email         String           @unique
  fullName      String?          @map("full_name")
  avatarUrl     String?          @map("avatar_url")
  phone         String?
  role          String           @default("USER") // USER | SUPER_ADMIN
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  memberships   BusinessMember[]
  ownedBusinesses Business[]     @relation("BusinessOwner")
  assignedConversations Conversation[] @relation("AssignedAgent")
  auditLogs     AuditLog[]

  @@map("users")
}

model Business {
  id          String           @id @default(uuid())
  name        String
  description String?
  industry    String?
  phone       String?
  email       String?
  website     String?
  address     String?
  timezone    String           @default("Africa/Lagos")
  currency    String           @default("NGN") // ISO 4217 code
  logoUrl     String?          @map("logo_url")
  ownerId     String           @map("owner_id")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  owner       User             @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     BusinessMember[]
  socialAccounts SocialAccount[]
  offerings   Offering[]
  customers   Customer[]
  leads       Lead[]
  conversations Conversation[]
  bookings    Booking[]
  orders      Order[]
  payments    Payment[]
  knowledgeBases KnowledgeBase[]
  automationRules AutomationRule[]
  auditLogs   AuditLog[]

  @@map("businesses")
}

enum MemberRole {
  OWNER
  ADMIN
  AGENT
}

model BusinessMember {
  id          String     @id @default(uuid())
  businessId  String     @map("business_id")
  userId      String     @map("user_id")
  role        MemberRole @default(AGENT)
  permissions String[]   @default([])
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  business    Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@map("business_members")
}

enum SocialPlatform {
  WHATSAPP
  INSTAGRAM
  TELEGRAM
  FACEBOOK
}

enum SocialAccountStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  PENDING
}

model SocialAccount {
  id                   String              @id @default(uuid())
  businessId           String              @map("business_id")
  platform             SocialPlatform
  accountId            String              @map("account_id")
  status               SocialAccountStatus @default(PENDING)
  encryptedAccessToken String?             @map("encrypted_access_token")
  metadata             Json                @default("{}")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  business             Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, platform, accountId])
  @@map("social_accounts")
}

// ── 2. Catalog & Offerings (Products & Services) ──────────────────────────────

enum OfferingType {
  PRODUCT
  SERVICE
}

model Offering {
  id              String       @id @default(uuid())
  businessId      String       @map("business_id")
  name            String
  description     String?
  type            OfferingType
  price           Decimal      @db.Decimal(12, 2)
  currency        String       @default("NGN")
  imageUrl        String?      @map("image_url")
  specifications  Json?
  durationMinutes Int?         @map("duration_minutes") // Applicable to SERVICES
  sku             String?
  stockQuantity   Int?         @map("stock_quantity")   // Applicable to PRODUCTS
  isActive        Boolean      @default(true) @map("is_active")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  business        Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings        Booking[]
  orderItems      OrderItem[]

  @@index([businessId, isActive])
  @@map("offerings")
}

// ── 3. Customers & Leads ──────────────────────────────────────────────────────

model Customer {
  id          String         @id @default(uuid())
  businessId  String         @map("business_id")
  name        String
  phone       String?
  email       String?
  notes       String?
  tags        String[]       @default([])
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  leads       Lead[]
  conversations Conversation[]
  bookings    Booking[]
  orders      Order[]

  @@unique([businessId, phone])
  @@index([businessId, email])
  @@map("customers")
}

enum LeadStatus {
  NEW
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
}

model Lead {
  id          String     @id @default(uuid())
  businessId  String     @map("business_id")
  customerId  String     @map("customer_id")
  status      LeadStatus @default(NEW)
  source      String?    @default("WHATSAPP")
  score       Int        @default(0)
  budget      Decimal?   @db.Decimal(12, 2)
  summary     String?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  business    Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer    Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
  @@map("leads")
}

// ── 4. Conversations & Messages ──────────────────────────────────────────────

enum ConversationStatus {
  AI_ACTIVE
  HANDOVER_PENDING
  HUMAN_TAKEN_OVER
  RESOLVED
}

model Conversation {
  id              String             @id @default(uuid())
  businessId      String             @map("business_id")
  customerId      String             @map("customer_id")
  channel         SocialPlatform     @default(WHATSAPP)
  status          ConversationStatus @default(AI_ACTIVE)
  assignedAgentId String?            @map("assigned_agent_id")
  lastMessageAt   DateTime           @default(now()) @map("last_message_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  business        Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer        Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedAgent   User?              @relation("AssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  messages        Message[]

  @@index([businessId, status])
  @@map("conversations")
}

enum SenderType {
  CUSTOMER
  AI_AGENT
  HUMAN_AGENT
  SYSTEM
}

model Message {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  senderType     SenderType   @map("sender_type")
  senderId       String?      @map("sender_id")
  content        String
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now()) @map("created_at")

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ── 5. Bookings ──────────────────────────────────────────────────────────────

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Booking {
  id          String        @id @default(uuid())
  businessId  String        @map("business_id")
  customerId  String        @map("customer_id")
  offeringId  String        @map("offering_id")
  startTime   DateTime      @map("start_time")
  endTime     DateTime      @map("end_time")
  status      BookingStatus @default(PENDING)
  notes       String?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer    Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  offering    Offering      @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@index([businessId, startTime])
  @@map("bookings")
}

// ── 6. Orders & Payments ─────────────────────────────────────────────────────

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  CANCELLED
  FULFILLED
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

model Order {
  id            String        @id @default(uuid())
  businessId    String        @map("business_id")
  customerId    String        @map("customer_id")
  status        OrderStatus   @default(DRAFT)
  totalAmount   Decimal       @map("total_amount") @db.Decimal(12, 2)
  currency      String        @default("NGN")
  paymentLink   String?       @map("payment_link")
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items         OrderItem[]
  payments      Payment[]

  @@index([businessId, status])
  @@map("orders")
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String   @map("order_id")
  offeringId String   @map("offering_id")
  quantity   Int      @default(1)
  unitPrice  Decimal  @map("unit_price") @db.Decimal(12, 2)

  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  offering   Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model Payment {
  id                String        @id @default(uuid())
  businessId        String        @map("business_id")
  orderId           String        @map("order_id")
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("NGN")
  status            PaymentStatus @default(PENDING)
  paystackReference String?       @unique @map("paystack_reference")
  paidAt            DateTime?     @map("paid_at")
  createdAt         DateTime      @default(now()) @map("created_at")

  business          Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
  @@map("payments")
}

// ── 7. Knowledge Base & RAG ──────────────────────────────────────────────────

model KnowledgeBase {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  title      String
  content    String
  category   String?  @default("GENERAL")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, category])
  @@map("knowledge_bases")
}

// ── 8. Automations & Audit Logs ──────────────────────────────────────────────

model AutomationRule {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  name       String
  trigger    String
  action     String
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("automation_rules")
}

model AuditLog {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  userId     String?  @map("user_id")
  action     String
  details    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@map("audit_logs")
}
