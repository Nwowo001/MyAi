# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/

# ── Build Outputs ─────────────────────────────────────────────────────────────
dist/
.next/
out/
build/
*.js.map
*.d.ts.map

# ── Environment Variables ─────────────────────────────────────────────────────
# NEVER commit real secrets.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Do commit .env.example files — they document required variables.
!.env.example
!apps/**/.env.example

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*

# ── OS & Editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/settings.json
.idea/

# ── Turbo ─────────────────────────────────────────────────────────────────────
.turbo/

# ── Testing ───────────────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Prisma ────────────────────────────────────────────────────────────────────
# Keep schema and migrations but ignore generated client (rebuilt on install)
prisma/generated/

# ── Misc ─────────────────────────────────────────────────────────────────────
*.tsbuildinfo
